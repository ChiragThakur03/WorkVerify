{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|auth/callback|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
