# PUBLIC APPLICATION URL
# Used for OAuth callback redirects and shareable profile links (e.g. https://workverify.vercel.app)
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (PostgreSQL Database)
# Create a project at https://supabase.com and run supabase/schema.sql in the SQL Editor
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# GOOGLE OAUTH CONFIGURATION (Continue with Google)
# Create an OAuth 2.0 Client ID in Google Cloud Console (APIs & Services -> Credentials)
# Authorized redirect URI: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# GITHUB OAUTH & API CONFIGURATION (Connect GitHub Account)
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL: <APP_URL>/auth/callback
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Optional GitHub Personal Access Token (increases public REST API rate limits from 60/hr to 5000/hr)
GITHUB_TOKEN=""
